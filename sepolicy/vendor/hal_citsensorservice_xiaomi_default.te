type hal_citsensorservice_xiaomi_default, domain;
type hal_citsensorservice_xiaomi_default_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(hal_citsensorservice_xiaomi_default)

# Allow it to use Qualcomm IPC sockets and binder
allow hal_citsensorservice_xiaomi_default self:qipcrtr_socket create_socket_perms_no_ioctl;
vndbinder_use(hal_citsensorservice_xiaomi_default)

# Allow Binder calls to hwservicemanager
allow hal_citsensorservice_xiaomi_default hwservicemanager:binder { call transfer };
allow hal_citsensorservice_xiaomi_default hal_graphics_composer_default:binder { call transfer };


# Allow reading required properties
get_prop(hal_citsensorservice_xiaomi_default, hwservicemanager_prop)
get_prop(hal_citsensorservice_xiaomi_default, vendor_sensors_prop)

# Allow access to backlight nodes
allow hal_citsensorservice_xiaomi_default vendor_sysfs_graphics:dir search;
allow hal_citsensorservice_xiaomi_default vendor_sysfs_graphics:file rw_file_perms;

# Allow access to persistent sensor files
allow hal_citsensorservice_xiaomi_default mnt_vendor_file:dir search;
allow hal_citsensorservice_xiaomi_default vendor_persist_sensors_file:dir search;
allow hal_citsensorservice_xiaomi_default vendor_persist_sensors_file:file { rw_file_perms getattr append };
