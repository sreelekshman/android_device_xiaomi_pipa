type vendor_displayfeature, domain;
type vendor_displayfeature_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(vendor_displayfeature)

vndbinder_use(vendor_displayfeature)
binder_use(vendor_displayfeature)

binder_call(vendor_displayfeature, hwservicemanager)
binder_call(vendor_displayfeature, vendor_hal_displayfeature_xiaomi_default)

allow vendor_displayfeature vendor_hal_displayfeature_xiaomi_hwservice:hwservice_manager find;
