android_app {
    name: "PipaControls",

    defaults: [
        "SettingsLibDefaults",
    ],

    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],

    certificate: "platform",
    platform_apis: true,
    privileged: true,
    system_ext_specific: true,

    static_libs: [
        "androidx.core_core",
        "androidx.preference_preference",
        "androidx.viewpager_viewpager",
        "androidx.recyclerview_recyclerview",
        "androidx.cardview_cardview",
    ],

    optimize: {
        proguard_flags_files: ["proguard.flags"],
    },

    required: [
        "xiaomi-pen",
        "xiaomi-keyboard",
        "privapp_whitelist_org.lineageos.pipacontrols.xml",
    ],
}

prebuilt_etc {
    name: "privapp_whitelist_org.lineageos.pipacontrols.xml",
    src: "permissions/privapp_whitelist_org.lineageos.pipacontrols.xml",
    sub_dir: "permissions",
    system_ext_specific: true,
}

cc_binary {
    name: "xiaomi-pen",
    vendor: true,
    srcs: [
        "xiaomi-pen.cpp",
    ],
    shared_libs: [
        "libcutils",
        "liblog",
    ],
}

cc_binary {
    name: "xiaomi-keyboard",
    vendor: true,
    srcs: [
        "xiaomi-keyboard.cpp",
    ],
    shared_libs: [
        "libcutils",
        "liblog",
        "libsensorndkbridge",
    ],
}
