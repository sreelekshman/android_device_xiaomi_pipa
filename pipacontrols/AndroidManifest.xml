<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.lineageos.pipacontrols"
    android:versionCode="1"
    android:versionName="1.0"
    android:sharedUserId="android.uid.system">

    <uses-sdk
        android:minSdkVersion="30"
        android:targetSdkVersion="36" />

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <uses-permission android:name="android.permission.INTERACT_ACROSS_USERS_FULL" />
    <uses-permission android:name="android.permission.ACCESS_SURFACE_FLINGER" />
    <uses-permission android:name="android.permission.BIND_QUICK_SETTINGS_TILE" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.INTERNAL_SYSTEM_WINDOW" />

    <permission
        android:name="org.lineageos.pipacontrols.permission.REFRESH_SERVICE"
        android:protectionLevel="signature" />

    <application
        android:icon="@drawable/ic_pipa_controls"
        android:label="@string/pipa_controls_title"
        android:persistent="true"
        android:defaultToDeviceProtectedStorage="true"
        android:directBootAware="true"
        android:theme="@style/Theme.AppSubSettings">

        <receiver
            android:name=".BootCompletedReceiver"
            android:exported="true"
            android:permission="android.permission.RECEIVE_BOOT_COMPLETED">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".ScreenStateReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.SCREEN_ON" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".keyboard.KeyboardPropertyHandler"
            android:exported="false">
            <intent-filter>
                <action android:name="org.lineageos.pipacontrols.KEYBOARD_MODE_CHANGED" />
            </intent-filter>
        </receiver>

        <activity
            android:name=".PipaControlsActivity"
            android:icon="@drawable/ic_pipa_controls"
            android:label="@string/pipa_controls_title"
            android:theme="@style/Theme.AppSubSettings"
            android:exported="true">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.homepage" />
            <meta-data
                android:name="com.android.settings.keyhint"
                android:value="top_level_pipa_controls" />
            <meta-data
                android:name="com.android.settings.group_key"
                android:value="top_level_system_info_category" />
            <meta-data
                android:name="com.android.settings.icon"
                android:resource="@drawable/ic_pipa_controls" />
            <meta-data
                android:name="com.android.settings.summary"
                android:resource="@string/pipa_controls_summary" />
            <meta-data
                android:name="com.android.settings.order"
                android:value="-22" />
        </activity>

        <activity
            android:name=".stylus.StylusSettingsActivity"
            android:label="@string/stylus_title"
            android:theme="@style/Theme.AppSubSettings"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
        </activity>

        <service
            android:name=".stylus.StylusTileService"
            android:icon="@drawable/ic_stylus_tile_off"
            android:label="@string/stylus_title"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />
        </service>

        <service
            android:name=".stylus.PenChargingService"
            android:exported="true"
            android:directBootAware="true">
            <intent-filter>
                <action android:name="org.lineageos.pipacontrols.ACTION_SHOW_STYLUS_POPUP" />
            </intent-filter>
        </service>

        <activity
            android:name=".keyboard.KeyboardSettingsActivity"
            android:label="@string/keyboard_title"
            android:theme="@style/Theme.AppSubSettings"
            android:exported="true">
        </activity>

        <activity
            android:name=".lid.LidSettingsActivity"
            android:label="@string/lid_title"
            android:theme="@style/Theme.AppSubSettings"
            android:exported="true">
        </activity>

        <activity
            android:name=".bypasscharging.BypassChargingActivity"
            android:label="@string/bypass_charging_title"
            android:theme="@style/Theme.AppSubSettings"
            android:exported="false">
        </activity>

        <activity
            android:name=".refreshrate.RefreshActivity"
            android:label="@string/refresh_title"
            android:theme="@style/Theme.AppSubSettings"
            android:exported="false">
        </activity>

        <service
            android:name=".refreshrate.RefreshService"
            android:exported="false"
            android:permission="org.lineageos.pipacontrols.permission.REFRESH_SERVICE">
        </service>

        <activity
            android:name=".saturation.SaturationActivity"
            android:label="@string/saturation_title"
            android:theme="@style/Theme.AppSubSettings"
            android:exported="false">
        </activity>

        <activity
            android:name=".apppriority.AppPriorityActivity"
            android:label="@string/app_priority_title"
            android:theme="@style/Theme.AppSubSettings"
            android:exported="false">
        </activity>

        <activity
            android:name=".performance.cpugovernor.CpuGovernorActivity"
            android:label="@string/cpu_governor_title"
            android:theme="@style/Theme.AppSubSettings"
            android:exported="false">
        </activity>

        <activity
            android:name=".performance.cpufreqcap.CpuFreqCapActivity"
            android:label="@string/cpu_freq_cap_title"
            android:theme="@style/Theme.AppSubSettings"
            android:exported="false">
        </activity>

        <activity
            android:name=".performance.gpugovernor.GpuGovernorActivity"
            android:label="@string/gpu_governor_title"
            android:theme="@style/Theme.AppSubSettings"
            android:exported="false">
        </activity>

        <activity
            android:name=".performance.gpufreqcap.GpuFreqCapActivity"
            android:label="@string/gpu_freq_cap_title"
            android:theme="@style/Theme.AppSubSettings"
            android:exported="false">
        </activity>

        <activity
            android:name=".performance.cpuscheduler.PreferBigCoresActivity"
            android:label="@string/prefer_big_cores_title"
            android:theme="@style/Theme.AppSubSettings"
            android:exported="false">
        </activity>

        <activity
            android:name=".performance.cpuscheduler.CoreMigrationActivity"
            android:label="@string/core_migration_title"
            android:theme="@style/Theme.AppSubSettings"
            android:exported="false">
        </activity>

        <activity
            android:name=".performance.cpuscheduler.CpuRampSpeedActivity"
            android:label="@string/cpu_ramp_speed_title"
            android:theme="@style/Theme.AppSubSettings"
            android:exported="false">
        </activity>

        <activity
            android:name=".touch.TouchBoostActivity"
            android:label="@string/touch_boost_title"
            android:theme="@style/Theme.AppSubSettings"
            android:exported="false">
        </activity>

        <activity
            android:name=".touch.BigCoresTouchActivity"
            android:label="@string/big_cores_touch_title"
            android:theme="@style/Theme.AppSubSettings"
            android:exported="false">
        </activity>

        <activity
            android:name=".touch.BoostDurationActivity"
            android:label="@string/boost_duration_title"
            android:theme="@style/Theme.AppSubSettings"
            android:exported="false">
        </activity>

    </application>
</manifest>
