<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:title="@string/stylus_title">

    <SwitchPreferenceCompat
        android:key="force_recognize_stylus_key"
        android:title="@string/force_stylus_switch_title"
        android:summary="@string/force_stylus_switch_summary"
        android:defaultValue="false" />

    <ListPreference
        android:key="stylus_refresh_rate_key"
        android:title="@string/stylus_refresh_rate_title"
        android:summary="%s"
        android:entries="@array/refresh_rate_entries"
        android:entryValues="@array/refresh_rate_values"
        android:defaultValue="dynamic" />

    <SwitchPreferenceCompat
        android:key="stylus_charging_notification_key"
        android:title="@string/stylus_charging_notification_title"
        android:summary="@string/stylus_charging_notification_summary"
        android:defaultValue="true" />

    <com.android.settingslib.widget.FooterPreference
        android:key="footer_key"
        android:title="@string/stylus_more_info"
        android:selectable="false" />

</PreferenceScreen>
