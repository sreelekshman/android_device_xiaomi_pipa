    <string name="app_name">Менеджер периферийных устройств Xiaomi</string>

    
    <string name="stylus_title">Стилус</string>
    <string name="stylus_summary">Настройки стилуса</string>
    <string name="stylus_switch_title">Режим стилуса</string>
    <string name="stylus_tile_label">Режим стилуса</string>
    <string name="force_stylus_switch_title">Принудительное распознавание стилуса</string>
    <string name="force_stylus_switch_summary">Позволяет официальному стилусу работать без Bluetooth и включает поддержку сторонних стилусов. Также заставляет дисплей работать с частотой 60/120 Гц, даже если перо не подключено.</string>
    <string name="stylus_refresh_rate_title">Частота обновления</string>
    <string name="stylus_refresh_rate_summary">Выбор частоты обновления дисплея для режима стилуса</string>
    <string name="stylus_more_info">Режим стилуса обеспечивает частоту обновления, совместимую с пером, при подключении поддерживаемого стилуса. Дисплей переключается на 60 Гц или 120 Гц только при подключенном пере.</string>

    
    <string name="refresh_rate_dynamic">Динамический (60/120 Гц)</string>
