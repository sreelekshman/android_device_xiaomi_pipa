    <string name="stylus_footer_refresh_rate">Частота обновления: %s</string>

    
    <string name="lid_title">Умная обложка</string>
    <string name="lid_summary">Настройки смарт-обложки</string>
    <string name="lid_switch_title">Переключить поведение Smart Cover</string>
    <string name="lid_switch_summary">Это переключает поведение умной крышки.</string>

    
    <string name="keyboard_title">Умная клавиатура</string>
    <string name="keyboard_summary">Настройки смарт-клавиатуры</string>
    <string name="keyboard_switch_title">Поддержка клавиатуры</string>
    <string name="keyboard_more_info">Включите это, только если у вас есть умная клавиатура Xiaomi Smart Keyboard. Если этот параметр включен, система (будем надеяться) автоматически обнаружит подключение клавиатуры и будет управлять состояниями питания. Отключение этого параметра позволяет экономить аккумулятор и системные ресурсы.\n\nПримечание. Это отличается от клавиатур Bluetooth, которые работают без этой настройки.</string>
    <string name="keyboard_status_enabled">Мониторинг клавиатуры включен</string>
    <string name="keyboard_status_disabled">Мониторинг клавиатуры отключен</string>
